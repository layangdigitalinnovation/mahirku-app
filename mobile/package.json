{
  "name": "mahirku-mobile",
  "version": "1.0.31",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "dev-client": "expo start --dev-client",
    "reverse": "powershell -NoProfile -Command \"$adbCandidates = @( (Join-Path $env:LOCALAPPDATA 'Android\\Sdk\\platform-tools\\adb.exe'), (Join-Path $env:USERPROFILE '.android\\adb.exe'), 'D:\\Android\\Sdk\\platform-tools\\adb.exe', 'D:\\Android\\sdk\\platform-tools\\adb.exe', 'C:\\Android\\Sdk\\platform-tools\\adb.exe' ); $adbPath = (Get-Command adb -ErrorAction SilentlyContinue).Path; if (-not $adbPath) { foreach ($c in $adbCandidates) { if (Test-Path $c) { $adbPath = $c; break } } } if (-not $adbPath) { Write-Warning 'adb not available or no device connected'; exit 1 } ; & $adbPath reverse tcp:8081 tcp:8081; & $adbPath reverse tcp:5000 tcp:5000; Write-Host 'adb reverse set for 8081 and 5000'\"",
    "android:reverse": "npm run reverse && expo run:android",
    "dev-client:reverse": "npm run reverse && expo start --dev-client",
    "ios": "expo run:ios",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@tanstack/react-query": "^5.29.0",
    "axios": "^1.6.8",
    "babel-preset-expo": "~13.0.0",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.1",
    "expo-build-properties": "^0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "^55.0.11",
    "expo-linear-gradient": "~14.1.5",
    "expo-modules-autolinking": "~2.1.0",
    "expo-print": "~14.1.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "^0.28.18",
    "expo-web-browser": "~14.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.79.6",
    "react-native-biometrics": "^3.0.1",
    "react-native-date-picker": "^5.0.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-url-polyfill": "^1.3.0",
    "react-native-webview": "^13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.0.10",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.8.3"
  }
}