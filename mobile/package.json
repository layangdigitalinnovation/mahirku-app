{
  "name": "mahirku-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "dev-client": "expo start --dev-client",
    "reverse": "powershell -NoProfile -Command \"$adbCandidates = @( (Join-Path $env:LOCALAPPDATA 'Android\\Sdk\\platform-tools\\adb.exe'), (Join-Path $env:USERPROFILE '.android\\adb.exe'), 'D:\\Android\\Sdk\\platform-tools\\adb.exe', 'D:\\Android\\sdk\\platform-tools\\adb.exe', 'C:\\Android\\Sdk\\platform-tools\\adb.exe' ); $adbPath = (Get-Command adb -ErrorAction SilentlyContinue).Path; if (-not $adbPath) { foreach ($c in $adbCandidates) { if (Test-Path $c) { $adbPath = $c; break } } } if (-not $adbPath) { Write-Warning 'adb not available or no device connected'; exit 1 } ; & $adbPath reverse tcp:8081 tcp:8081; & $adbPath reverse tcp:5000 tcp:5000; Write-Host 'adb reverse set for 8081 and 5000'\"",
    "android:reverse": "npm run reverse && expo run:android",
    "dev-client:reverse": "npm run reverse && expo start --dev-client",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/config-plugins": "~9.0.0",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.7.0",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.11.0",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.1",
    "expo-auth-session": "~6.0.1",
    "expo-build-properties": "~0.13.1",
    "expo-clipboard": "~7.0.0",
    "expo-crypto": "~14.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-file-system": "~18.0.3",
    "expo-font": "~13.0.1",
    "expo-linear-gradient": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.9",
    "expo-web-browser": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-biometrics": "^3.0.1",
    "react-native-date-picker": "^5.0.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^1.3.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.3.3"
  }
}