{
    "cli": {
        "version": ">= 12.5.2"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "gradleCommand": ":app:assembleDebug"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://mahirku.com"
            },
            "android": {
                "gradleCommand": ":app:assembleRelease"
            }
        },
        "production": {
            "channel": "production",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://mahirku.com"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
