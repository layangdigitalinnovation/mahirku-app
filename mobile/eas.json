{
    "cli": {
        "version": ">= 12.5.2",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleDebug"
            },
            "prebuildCommand": "node eas-build-prebuild-hook.js"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://mahirku.com"
            },
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease"
            },
            "prebuildCommand": "node eas-build-prebuild-hook.js"
        },
        "production": {
            "channel": "production",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://mahirku.com"
            },
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle"
            },
            "prebuildCommand": "node eas-build-prebuild-hook.js"
        }
    },
    "submit": {
        "production": {}
    }
}