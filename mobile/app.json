{
  "expo": {
    "name": "Mahirku",
    "slug": "mahirku-mobile",
    "scheme": "mahirku",
    "version": "1.0.21",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/48ffbe31-63a3-4e66-a5f0-308b51e4fd6c"
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.mahirku.app",
      "versionCode": 7,
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Aplikasi membutuhkan akses kamera untuk mengambil foto tulisan tangan analisis grafologi Anda.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "48ffbe31-63a3-4e66-a5f0-308b51e4fd6c"
      },
      "GOOGLE_WEB_CLIENT_ID": "1061850144136-r1k407gtpglk67otkdvdqbo55eknhdj2.apps.googleusercontent.com"
    }
  }
}